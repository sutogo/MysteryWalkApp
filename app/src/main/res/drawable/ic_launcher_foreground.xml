<?xml version="1.0" encoding="utf-8"?>
<!--
    Mystery Walk — アイコン前景
    コンパス（方位磁針）をモチーフにしたネオンシアンデザイン
    Adaptive Icon の foreground レイヤー (108dp × 108dp)
    safe zone: 中央 72dp × 72dp (座標 18〜90)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ───────────────────────────────────
         外周リング（コンパスベゼル）
         中心 (54, 54)、半径 32
    ─────────────────────────────────── -->
    <!-- 外周リング本体 -->
    <path
        android:pathData="M54,54 m-32,0 a32,32 0 1,0 64,0 a32,32 0 1,0 -64,0"
        android:fillColor="#00000000"
        android:strokeWidth="2">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="sweep"
                android:centerX="54"
                android:centerY="54">
                <item android:offset="0.0" android:color="#FF00F0FF"/>
                <item android:offset="0.25" android:color="#8000F0FF"/>
                <item android:offset="0.5" android:color="#FF00F0FF"/>
                <item android:offset="0.75" android:color="#4000F0FF"/>
                <item android:offset="1.0" android:color="#FF00F0FF"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- 内周リング（細い） -->
    <path
        android:pathData="M54,54 m-27,0 a27,27 0 1,0 54,0 a27,27 0 1,0 -54,0"
        android:fillColor="#00000000"
        android:strokeColor="#1A3A4A"
        android:strokeWidth="0.8" />

    <!-- ───────────────────────────────────
         基本方位の目盛り（N / E / S / W）
    ─────────────────────────────────── -->
    <!-- N（北）- 長い目盛り -->
    <path android:pathData="M54,22 L54,28" android:strokeColor="#00F0FF" android:strokeWidth="2.5" android:fillColor="#00000000" android:strokeLineCap="round"/>
    <!-- S（南）- 中程度目盛り -->
    <path android:pathData="M54,80 L54,85" android:strokeColor="#00B8C8" android:strokeWidth="1.8" android:fillColor="#00000000" android:strokeLineCap="round"/>
    <!-- E（東）- 中程度目盛り -->
    <path android:pathData="M80,54 L85,54" android:strokeColor="#00B8C8" android:strokeWidth="1.8" android:fillColor="#00000000" android:strokeLineCap="round"/>
    <!-- W（西）- 中程度目盛り -->
    <path android:pathData="M22,54 L27,54" android:strokeColor="#00B8C8" android:strokeWidth="1.8" android:fillColor="#00000000" android:strokeLineCap="round"/>

    <!-- 斜め方位 小目盛り（NE/SE/SW/NW）-->
    <path android:pathData="M76.7,31.3 L72.6,35.4" android:strokeColor="#1E5F6F" android:strokeWidth="1.2" android:fillColor="#00000000" android:strokeLineCap="round"/>
    <path android:pathData="M76.7,76.7 L72.6,72.6" android:strokeColor="#1E5F6F" android:strokeWidth="1.2" android:fillColor="#00000000" android:strokeLineCap="round"/>
    <path android:pathData="M31.3,76.7 L35.4,72.6" android:strokeColor="#1E5F6F" android:strokeWidth="1.2" android:fillColor="#00000000" android:strokeLineCap="round"/>
    <path android:pathData="M31.3,31.3 L35.4,35.4" android:strokeColor="#1E5F6F" android:strokeWidth="1.2" android:fillColor="#00000000" android:strokeLineCap="round"/>

    <!-- ───────────────────────────────────
         コンパスニードル（方位磁針）
         北向き: ネオンシアン（上向き三角）
         南向き: ゴールド（下向き三角）
    ─────────────────────────────────── -->
    <!-- 北向き針 - ネオンシアン -->
    <path
        android:pathData="M54,26 L58,54 L54,50 L50,54 Z"
        android:fillColor="#00F0FF"
        android:strokeColor="#00F0FF"
        android:strokeWidth="0.5" />

    <!-- 南向き針 - ゴールド -->
    <path
        android:pathData="M54,82 L58,54 L54,58 L50,54 Z"
        android:fillColor="#FFD700"
        android:strokeColor="#E6A300"
        android:strokeWidth="0.5" />

    <!-- 針のグロー効果（半透明で重ねる）-->
    <path
        android:pathData="M54,26 L57,54 L54,51 L51,54 Z"
        android:fillColor="#6000F0FF" />

    <!-- ───────────────────────────────────
         中心ピボット（円）
    ─────────────────────────────────── -->
    <!-- 外側グロー -->
    <path
        android:pathData="M54,54 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0"
        android:fillColor="#3000F0FF" />
    <!-- メイン円 -->
    <path
        android:pathData="M54,54 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0"
        android:fillColor="#0F172A"
        android:strokeColor="#00F0FF"
        android:strokeWidth="1.5" />
    <!-- 中心点 -->
    <path
        android:pathData="M54,54 m-1.2,0 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0"
        android:fillColor="#00F0FF" />

    <!-- ───────────────────────────────────
         N の文字（北マーカー）
         小さなドット表現
    ─────────────────────────────────── -->
    <path
        android:pathData="M54,54 m-1,0 a1,1 0 1,0 2,0 a1,1 0 1,0 -2,0"
        android:fillColor="#00000000" />

</vector>